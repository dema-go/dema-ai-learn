<view class="screen">
  <view class="meta">先从最轻的方式开始。首版支持文字和公开网页。</view>
  <button class="input-card" bindtap="onText">
    <text class="input-icon">📋</text>
    <view class="list-copy"><text class="name">粘贴文本</text><text class="sub">最稳，最多 8000 字</text></view>
    <text>›</text>
  </button>
  <button class="input-card" bindtap="onUrl">
    <text class="input-icon">🔗</text>
    <view class="list-copy"><text class="name">公开网页链接</text><text class="sub">自动提取正文，可先预览</text></view>
    <text>›</text>
  </button>
  <view class="section-title">更多输入方式</view>
  <button class="input-card" disabled bindtap="onSoon">
    <text class="input-icon">📷</text>
    <view class="list-copy"><text class="name">拍照识别</text><text class="sub">图片和扫描材料</text></view>
    <text class="soon">敬请期待</text>
  </button>
  <button class="input-card" disabled bindtap="onSoon">
    <text class="input-icon">📁</text>
    <view class="list-copy"><text class="name">PDF / Word / PPT</text><text class="sub">常用文档一键导入</text></view>
    <text class="soon">敬请期待</text>
  </button>
  <view class="card" style="margin-top:16px">
    <view class="card-title" style="margin-top:0">粘贴前看一眼</view>
    <view class="meta">请勿粘贴机密、病历或包含他人个人信息的内容。</view>
  </view>
</view>
