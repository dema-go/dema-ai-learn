<view class="screen" wx:if="{{question}}">
  <view class="question-head">
    <text class="status-pill">第 {{index + 1}} / {{quiz.question_count}} 题</text>
    <text class="tag">{{question.question_type === 'true_false' ? '判断题' : '单选题'}}</text>
  </view>
  <view class="progress" style="margin-top:12px"><view class="progress-bar" style="width: {{percent}}%;"></view></view>
  <view class="question-head" style="margin-top:18px">
    <text class="tag">{{question.question_type === 'true_false' ? '判断题' : '单选题'}}</text>
    <button class="text-btn" bindtap="onReport">这题有问题</button>
  </view>
  <view class="question">{{question.stem}}</view>
  <button
    wx:for="{{question.options}}"
    wx:key="*this"
    wx:for-index="optIndex"
    class="choice-card {{selected === optIndex ? 'selected' : ''}} {{submitted && optIndex === question.answer_index ? 'correct' : ''}} {{submitted && selected === optIndex && !isCorrect ? 'wrong' : ''}}"
    bindtap="onSelect"
    data-index="{{optIndex}}"
  >
    <text class="choice-key">{{keys[optIndex]}}</text>
    <text>{{item}}</text>
  </button>

  <view class="feedback {{isCorrect ? 'correct' : 'wrong'}}" wx:if="{{submitted}}">
    <view class="card-title">{{isCorrect ? '✓ 稳了，答对了' : '× 差一点，正确答案是 ' + keys[question.answer_index]}}</view>
    <view class="meta">{{explanation}}</view>
  </view>
  <button class="text-btn" wx:if="{{submitted}}" bindtap="toggleSource">🔎 查看原文依据</button>
  <view class="source-drawer" wx:if="{{showSource}}">
    <view class="card-title">原文依据</view>
    <view>{{sourceSpan}}</view>
  </view>
  <view class="ai-notice">✦ AI 依据你的材料生成，可能有误</view>
  <button class="btn" bindtap="onConfirm">{{submitted ? (finished ? '查看结果' : '下一题') : '确定答案'}}</button>
</view>
